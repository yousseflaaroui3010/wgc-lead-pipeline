    {
      "parameters": {
        "jsCode": "// ADR-2: stateless render token = base64(ts.nonce.HMAC_SHA256(secret, ts.nonce)).\n// Requires NODE_FUNCTION_ALLOW_BUILTIN=crypto and WGC_HMAC_SECRET in the environment.\nconst crypto = require('crypto');\nconst secret = $env.WGC_HMAC_SECRET;\nif (!secret) throw new Error('WGC_HMAC_SECRET is not set'); // fail loud, never issue unsigned tokens\nconst ts = String(Date.now());\nconst nonce = crypto.randomBytes(8).toString('hex');\nconst mac = crypto.createHmac('sha256', secret).update(ts + '.' + nonce).digest('hex');\nconst token = Buffer.from(ts + '.' + nonce + '.' + mac, 'utf8').toString('base64');\nreturn [{ json: { token } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "0af968e4-e544-4990-9620-284b34e3d992",
      "name": "Issue HMAC token",
